{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/bookstore/schemas/book.schema.json",
  "title": "Book",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "isbn", "price_vnd", "stock", "genre", "category_id", "author_ids", "created_at"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "isbn": {"type": "string", "pattern": "^(?:[0-9]{13}|[0-9]{9}[0-9Xx])$"},
    "price_vnd": {"type": "integer", "minimum": 0},
    "stock": {"type": "integer", "minimum": 0},
    "genre": {"type": "string", "minLength": 1, "maxLength": 80},
    "category_id": {"type": "integer", "minimum": 1},
    "author_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
